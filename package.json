{
  "name": "react-native-screen-choreography",
  "version": "1.0.0",
  "description": "Multi-step native tray navigation for React Navigation and Expo Router",
  "main": "./lib/module/entries/index.js",
  "types": "./lib/typescript/src/entries/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/entries/index.ts",
      "types": "./lib/typescript/src/entries/index.d.ts",
      "default": "./lib/module/entries/index.js"
    },
    "./expo-router": {
      "source": "./src/entries/expo-router.ts",
      "types": "./lib/typescript/src/entries/expo-router.d.ts",
      "default": "./lib/module/entries/expo-router.js"
    },
    "./package.json": "./package.json",
    "./tray": {
      "source": "./src/entries/tray.ts",
      "types": "./lib/typescript/src/entries/tray.d.ts",
      "default": "./lib/module/entries/tray.js"
    },
    "./mock": {
      "types": "./jest/index.d.ts",
      "default": "./jest/index.js"
    },
    "./mock/expo-router": {
      "types": "./jest/expo-router.d.ts",
      "default": "./jest/expo-router.js"
    },
    "./mock/tray": {
      "types": "./jest/tray.d.ts",
      "default": "./jest/tray.js"
    },
    "./expo-router/tray": {
      "source": "./src/entries/expo-router-tray.ts",
      "types": "./lib/typescript/src/entries/expo-router-tray.d.ts",
      "default": "./lib/module/entries/expo-router-tray.js"
    },
    "./mock/expo-router/tray": {
      "types": "./jest/expo-router-tray.d.ts",
      "default": "./jest/tray.js"
    }
  },
  "files": [
    "src",
    "lib",
    "jest",
    "!src/**/*.test.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-screen-choreography-example",
    "example:react-native": "yarn workspace react-native-screen-choreography-example",
    "example:expo-router": "yarn workspace screen-choreography-expo-router-example",
    "test": "jest",
    "clean": "del-cli android/build examples/react-navigation/android/build examples/react-navigation/android/app/build examples/react-navigation/ios/build examples/expo-router/android/build examples/expo-router/ios/build lib",
    "prepare": "bob build",
    "prepublishOnly": "yarn clean && yarn lint && yarn typecheck && yarn test --runInBand && yarn prepare",
    "typecheck": "tsc && yarn workspace react-native-screen-choreography-example typecheck && yarn workspace screen-choreography-expo-router-example typecheck",
    "lint": "eslint \"**/*.{js,ts,tsx,mts}\"",
    "lint:fix": "eslint \"**/*.{js,ts,tsx,mts}\" --fix",
    "docs:dev": "yarn workspace screen-choreography-docs dev",
    "docs:build": "yarn workspace screen-choreography-docs build",
    "docs:preview": "yarn workspace screen-choreography-docs preview"
  },
  "keywords": [
    "react-native",
    "bottom-sheet",
    "navigation",
    "tray",
    "expo-router",
    "reanimated"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DorianMazur/react-native-screen-choreography.git"
  },
  "author": "MazurDorian <mazur.dorian15@gmail.com> (https://github.com/DorianMazur)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/DorianMazur/react-native-screen-choreography/issues"
  },
  "homepage": "https://screen-choreography.dev",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.3",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "@swmansion/react-native-bottom-sheet": "1.1.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.0",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.7.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.5",
    "expo-router": "~58.0.32",
    "jest": "^29.7.0",
    "prettier": "^3.8.1",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-builder-bob": "^0.41.0",
    "react-native-keyboard-controller": "1.23.1",
    "react-native-reanimated": "4.8.0",
    "react-native-worklets": "~0.14.0",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "@react-navigation/native": ">=7.0.0",
    "@react-navigation/native-stack": ">=7.0.0",
    "@swmansion/react-native-bottom-sheet": "^1.1.0",
    "expo-router": ">=58.0.0",
    "react": ">=19.2.0",
    "react-native": ">=0.87.0",
    "react-native-keyboard-controller": "^1.23.1",
    "react-native-reanimated": "^4.8.0",
    "react-native-worklets": ">=0.14.0"
  },
  "peerDependenciesMeta": {
    "@react-navigation/native": {
      "optional": true
    },
    "@react-navigation/native-stack": {
      "optional": true
    },
    "expo-router": {
      "optional": true
    }
  },
  "workspaces": [
    "docs",
    "examples/*"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "sideEffects": false,
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "{**/{__tests__,__fixtures__,__mocks__}/**,**/*.test.*}",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "module-mixed",
    "languages": "kotlin-objc",
    "tools": [
      "eslint"
    ],
    "version": "0.60.0"
  }
}
