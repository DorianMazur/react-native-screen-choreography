{
  "name": "screen-choreography-expo-router-example",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@screen-choreography/example-shared": "workspace:*",
    "@swmansion/react-native-bottom-sheet": "1.1.0",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.23.1",
    "react-native-reanimated": "4.8.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screen-choreography": "workspace:*",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "~0.14.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~58.0.0",
    "react-native-monorepo-config": "^0.3.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android": "cd android && ./gradlew app:assembleDebug --no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a",
    "build:ios": "xcodebuild -workspace ios/ScreenChoreographyRouter.xcworkspace -scheme ScreenChoreographyRouter -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web"
  },
  "private": true
}
