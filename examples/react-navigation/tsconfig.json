{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "react-native-safe-area-context": [
        "./node_modules/react-native-safe-area-context"
      ],
      "react-native-screen-choreography/core": ["../../src/core-entry.ts"],
      "react-native-screen-choreography": ["../../src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../shared/**/*.ts",
    "../shared/**/*.tsx"
  ],
  "exclude": ["node_modules", "ios/Pods"]
}
