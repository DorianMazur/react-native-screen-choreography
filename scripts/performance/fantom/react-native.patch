diff --git a/private/react-native-fantom/tester/CMakeLists.txt b/private/react-native-fantom/tester/CMakeLists.txt
index 235f744..adc41d2 100644
--- a/private/react-native-fantom/tester/CMakeLists.txt
+++ b/private/react-native-fantom/tester/CMakeLists.txt
@@ -34,6 +34,19 @@ add_react_third_party_ndk_subdir(glog)
 add_react_third_party_ndk_subdir(double-conversion)
 add_react_third_party_ndk_subdir(fast_float)
 add_react_third_party_ndk_subdir(fmt)
+# RN 0.83's fmt 11.0.2 consteval parser is incompatible with Apple Clang 21.
+if(CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang" AND CMAKE_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 21)
+  set(FMT_BASE "${REACT_THIRD_PARTY_NDK_DIR}/fmt/include/fmt/base.h")
+  file(READ "${FMT_BASE}" FMT_CONTENT)
+  set(FMT_ORIGINAL "${FMT_CONTENT}")
+  string(REPLACE "#if !defined(__cpp_lib_is_constant_evaluated)"
+    "#if defined(FMT_USE_CONSTEVAL)\n// Use the provided definition.\n#elif !defined(__cpp_lib_is_constant_evaluated)"
+    FMT_CONTENT "${FMT_CONTENT}")
+  if(NOT FMT_CONTENT STREQUAL FMT_ORIGINAL)
+    file(WRITE "${FMT_BASE}" "${FMT_CONTENT}")
+  endif()
+  target_compile_definitions(fmt PUBLIC FMT_USE_CONSTEVAL=0)
+endif()
 add_fantom_third_party_subdir(folly)
 add_fantom_third_party_subdir(gflags)
 add_fantom_third_party_subdir(nlohmann_json)
@@ -246,3 +259,15 @@ target_compile_options(fantom_tester
     -fexceptions
     -frtti
     -std=c++20)
+
+# Compile the library source directly; edits are picked up by CMake on every run.
+set(CHOREOGRAPHY_ROOT "$ENV{CHOREOGRAPHY_ROOT}")
+if(NOT EXISTS "${CHOREOGRAPHY_ROOT}/cpp/FabricLayoutCapture.cpp")
+  message(FATAL_ERROR "CHOREOGRAPHY_ROOT must point to react-native-screen-choreography")
+endif()
+target_sources(fantom_tester PRIVATE "${CHOREOGRAPHY_ROOT}/cpp/FabricLayoutCapture.cpp")
+target_include_directories(fantom_tester PRIVATE "${CHOREOGRAPHY_ROOT}/cpp")
+# Match Linux thread CPU timing used by Meta's benchmark harness.
+if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
+  target_compile_definitions(react_nativemodule_cpu PRIVATE USE_POSIX_TIME)
+endif()
